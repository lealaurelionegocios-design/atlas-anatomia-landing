{
  "name": "cleanflow-business-manager",
  "version": "0.1.0",
  "private": true,
  "description": "CleanFlow Business Manager — clients, quotes, jobs, invoices, payments and a document kit for small residential cleaning businesses (US & UK).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:integration && npm run test:e2e",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime,storage-api,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "seed:demo": "tsx scripts/seed-demo-account.ts",
    "license": "node scripts/license-admin.mjs",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.2",
    "@types/react-dom": "19.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
