# CleanFlow Business Manager — environment variables
# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and the publishable (anon) key. These are safe to expose
# to the browser because every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the app (used for auth email redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Licensing gate. When "true", signed-in users need an active licence row
# (see docs/LICENSING.md). Leave "false" until a checkout provider is wired up.
CLEANFLOW_REQUIRE_LICENSE=false

# SERVER-ONLY. Needed only by scripts/license-admin.mjs, scripts/seed-demo-account.mjs
# and the integration tests. Never prefix with NEXT_PUBLIC_ and never set it in
# the browser-facing deployment unless a server feature requires it.
SUPABASE_SERVICE_ROLE_KEY=
